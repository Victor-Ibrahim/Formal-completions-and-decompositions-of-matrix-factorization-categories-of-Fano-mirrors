LIB "sing.lib";
ring r = 0,(y,z,t),ds;   // chart X=1
proc FF(poly l){ return( y^2 + y^2*t + y*t + y*z + y^2*z + y*t^2 + 4*y*z*t + y*z*t^2 + z*t^2 + y*z^2 + z*t^3 + y*z^2*t + z^2*t + z^2*t^2 - l*y*z*t ); }
// P4=[1:1:-1:0] -> (y,z,t)=(1,-1,0), lam0=0
poly g = subst(subst(FF(0),y,y+1),z,z-1); "P4, lam=0: value", jet(g,0), " milnor", milnor(g); "  hessian rank:"; rank(jacob(jacob(jet(g,2))));
// P5=[1:1:0:-1] -> (1,0,-1), lam0=1
g = subst(subst(FF(1),y,y+1),t,t-1); "P5, lam=1: value", jet(g,0), " milnor", milnor(g); "  hessian rank:"; rank(jacob(jacob(jet(g,2))));
// P5^1=[1:0:1:-1] -> (0,1,-1), lam0=2
g = subst(subst(FF(2),z,z+1),t,t-1); "P5^1, lam=2: value", jet(g,0), " milnor", milnor(g); "  hessian rank:"; rank(jacob(jacob(jet(g,2))));
// generic lam at P4, P5 (smooth?)
g = subst(subst(FF(3),y,y+1),z,z-1); "P4, lam=3: linear part", jet(g,1);
g = subst(subst(FF(3),y,y+1),t,t-1); "P5, lam=3: linear part", jet(g,1);
quit;
